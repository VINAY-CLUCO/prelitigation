{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "volumes": {
      "/app/.cluco_data": "cluco_data_volume",
      "/app/prisma": "prisma_sqlite_volume"
    }
  }
}
