// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  integrations Integration[]
  matters      Matter[]
  documents    Document[]
  tasks        Task[]
  events       Event[]
}

model Integration {
  id           String   @id @default(uuid())
  userId       String
  platform     String   // e.g., "google_drive", "clio"
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model Matter {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  status      String?
  clientId    String?
  source      String?  // e.g. "clio", "mycase", "manual"
  sourceId    String?  // original ID in external system

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   Document[]
  tasks       Task[]
  events      Event[]
}

model Document {
  id           String   @id @default(uuid())
  userId       String
  matterId     String?
  name         String
  size         Int?
  type         String?
  aiTag        String?
  storagePath  String?  // Supabase Storage path
  source       String?  // e.g. "clio", "google_drive", "gmail"
  sourceId     String?
  downloaded   Boolean  @default(false)
  downloadedAt DateTime?
  emailSubject String?
  emailSender  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matter       Matter?  @relation(fields: [matterId], references: [id], onDelete: SetNull)
}

model Task {
  id          String   @id @default(uuid())
  userId      String
  matterId    String?
  name        String
  status      String?
  dueAt       DateTime?
  source      String?
  sourceId    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matter      Matter?  @relation(fields: [matterId], references: [id], onDelete: SetNull)
}

model Event {
  id          String   @id @default(uuid())
  userId      String
  matterId    String?
  summary     String
  startAt     DateTime
  endAt       DateTime?
  source      String?
  sourceId    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matter      Matter?  @relation(fields: [matterId], references: [id], onDelete: SetNull)
}

